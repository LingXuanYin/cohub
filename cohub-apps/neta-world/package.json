{
  "name": "@cohub/neta-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run i18n && vite build",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "npm run i18n && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint src/*.ts public/scripts",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@neta-art/cohub": "^11.0.0",
    "lucide-svelte": "^1.0.1",
    "pixi.js": "8.20.1",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
